7. 关键配置速查
Flag	默认	影响范围	说明
--urma_use_polling	false	完成事件	false=Event(epoll), true=Poll(bthread轮询)
--urma_poller_num	1	Poll 模式	每个 bthread tag 的轮询器数量
--urma_disable_bthread	false	消息分发	true=内联处理, 不起 bthread
--urma_sq_size	128	发送队列	本地 JFS 深度 [16, 4096]
--urma_rq_size	128	接收队列	本地 JFR 深度 [16, 4096]
--urma_cqe_poll_once	32	每次 poll	每次 urma_poll_jfc 上限
--urma_recv_zerocopy	true	接收路径	大包零拷贝
--urma_zerocopy_min_size	512	接收路径	小于此值走拷贝
--urma_buffer_size	8192	内存池	每个 buffer 大小
--urma_buffer_count	65536	内存池	buffer 数量
--urma_prepared_jetty_cnt	8	建链加速	预创建 Jetty 数
--urma_poller_yield	false	Poll 模式	空闲时 bthread_yield
--urma_client_handshake_version	2	握手协议	2=二进制, 3=protobuf
